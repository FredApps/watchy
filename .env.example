PORT=3090
HOST=127.0.0.1
BASE_PATH=/watchy
WATCHY_PASSWORD=change-me
WATCHY_PASSWORDS=change-me,backup-password
WATCHY_COOKIE_SECRET=
WATCHY_MEDIA_ROOT=
WATCHY_MEDIA_BASE_URL=
# Baked into the client bundle at build time. Without a TURN server the camera
# still works except behind symmetric NAT.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_STUN_URL=stun:stun.cloudflare.com:3478
# AI watch-along companion (OpenClaw gateway). Server-side only - never expose
# the token to the client. Without a token the companion stays disabled.
OPENCLAW_URL=https://claw.ayrien.se
OPENCLAW_TOKEN=
OPENCLAW_MODEL=openclaw
# The Discord channel people actually talk to the bot in. Watchy joins that
# channel's own session, so the companion shares one memory across Discord
# and the watch room. This must be the real channel id - a wrong-but-valid
# id silently creates a separate session nobody ever reads.
OPENCLAW_DISCORD_CHANNEL=
# Optional override if the session key is ever not
# agent:main:discord:channel:<OPENCLAW_DISCORD_CHANNEL>. Leave empty
# otherwise; without either, the gateway mints a new random session per
# request and the companion remembers nothing between comments.
OPENCLAW_SESSION_KEY=
# Absolute path: the service runs as SYSTEM and will not see a user PATH entry.
FFMPEG_PATH=ffmpeg
