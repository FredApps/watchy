PORT=3090
HOST=127.0.0.1
BASE_PATH=/watchy
WATCHY_PASSWORD=change-me
WATCHY_PASSWORDS=change-me,backup-password
WATCHY_COOKIE_SECRET=
WATCHY_MEDIA_ROOT=
WATCHY_MEDIA_BASE_URL=
# Baked into the client bundle at build time. Without a TURN server the camera
# still works except behind symmetric NAT.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_STUN_URL=stun:stun.cloudflare.com:3478
# AI watch-along companion (OpenClaw gateway). Server-side only - never expose
# the token to the client. Without a token the companion stays disabled.
OPENCLAW_URL=https://claw.ayrien.se
OPENCLAW_TOKEN=
OPENCLAW_MODEL=openclaw
OPENCLAW_DISCORD_CHANNEL=
# Absolute path: the service runs as SYSTEM and will not see a user PATH entry.
FFMPEG_PATH=ffmpeg
